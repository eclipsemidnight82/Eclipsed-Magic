{
  "multipart": [
    {
      "apply": {
        "model": "eclipse_grimoire:block/salt_dot"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "eclipse_grimoire:block/salt_north"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "eclipse_grimoire:block/salt_south"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "eclipse_grimoire:block/salt_east"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "eclipse_grimoire:block/salt_west"
      }
    }
  ]
}
